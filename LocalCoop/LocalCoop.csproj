<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>LocalCoop</AssemblyName>
    <RootNamespace>LocalCoop</RootNamespace>
    <Version>1.0.1</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- the test copy of the game: -p:GameDir=..., else %LC_WORK%\game-lc, else <repo>\work\game-lc (see SETUP.md) -->
    <GameDir Condition="'$(GameDir)' == '' And '$(LC_WORK)' != ''">$(LC_WORK)\game-lc</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildProjectDirectory)\..\work\game-lc</GameDir>
    <NoWarn>$(NoWarn);CS0436;CS0108</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
